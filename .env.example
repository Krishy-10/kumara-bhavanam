# Copy to .env.local and fill in. .env.local is gitignored. Never commit real values.
# Only VITE_* values reach the browser, so only public values belong here.

# demo = picker only, no sign-in, "Demo" badge. live = Google sign-in (not built yet).
VITE_APP_MODE=demo

# Supabase > Project Settings > API (or Data API)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The publishable / anon key. It is public by design; RLS protects the data.
# NEVER put the service_role / secret key here or anywhere in this repo.
VITE_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY
